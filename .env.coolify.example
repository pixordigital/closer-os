# Closer OS — Coolify Environment Variables
# Copy to Coolify → Resource → Environment (replace ALL placeholders)
# Never commit real values

# ── Database ──
DB_PASSWORD=<openssl rand -base64 24>

# ── Auth ──
AUTH_SECRET=<openssl rand -base64 32>
APP_URL=http://178.105.181.38:6002

# ── AI Providers (at least one required) ──
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Storage (S3 / MinIO / R2) — optional ──
STORAGE_ENDPOINT=
STORAGE_BUCKET=closer-os
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# ── Redis (optional — only if job queue needs it) ──
REDIS_URL=

# ── Observability ──
LOG_LEVEL=info

# ── Integrations (Phase 11) ──
GOOGLE_CALENDAR_CREDENTIALS=