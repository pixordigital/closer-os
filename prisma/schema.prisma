// Closer OS — Prisma Schema v1.0
// Covers Phase 1 foundation + forward-compatible stubs for all §23 entities
// DB: PostgreSQL | ORM: Prisma | pgvector: prepared (§8), enable when needed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum DecisionRole {
  DECISION_MAKER
  INFLUENCER
  CHAMPION
  USER
  BLOCKER
  UNKNOWN
}

enum DealStage {
  LEAD
  QUALIFIED
  DISCOVERY
  SOLUTION
  PROPOSAL
  NEGOTIATION
  VERBAL_COMMITMENT
  WON
  LOST
}

enum CallStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DiscoveryFieldStatus {
  UNKNOWN
  PARTIAL
  CONFIRMED
}

enum DiscoveryFieldSource {
  TRANSCRIPT
  USER
  CRM
  AI_INFERENCE
  EXTERNAL_RESEARCH
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum FollowUpType {
  EMAIL
  WHATSAPP
  LINKEDIN
  CRM_NOTE
  INTERNAL_SUMMARY
}

enum FollowUpStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  SENT
  CANCELLED
}

enum ObjectionCategory {
  PRICE
  TIMING
  AUTHORITY
  TRUST
  COMPETITION
  STATUS_QUO
  NEED
  PRIORITY
  IMPLEMENTATION
  RISK
  INTERNAL_APPROVAL
}

enum RoleplayDifficulty {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
  LEVEL_5
  LEVEL_6
  LEVEL_7
  BOSS
}

enum RoleplaySessionStatus {
  PENDING
  ACTIVE
  COMPLETED
  ABANDONED
}

enum Speaker {
  SELLER
  PROSPECT
  SYSTEM
}

enum ROIScenario {
  CONSERVATIVE
  BASE
  OPTIMISTIC
}

enum ForecastCategory {
  PIPELINE
  COMMIT
  BEST_CASE
  UPSIDE
  CLOSED_WON
  CLOSED_LOST
}

enum StakeholderRole {
  CHAMPION
  ECONOMIC_BUYER
  TECHNICAL_BUYER
  USER_BUYER
  INFLUENCER
  BLOCKER
  LEGAL_PROCUREMENT
  EXECUTIVE_SPONSOR
}

enum StakeholderInfluence {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum StakeholderSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  UNKNOWN
}

enum MAPItemStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

enum ProcurementStatus {
  NOT_STARTED
  QUESTIONNAIRE_SENT
  QUESTIONNAIRE_RECEIVED
  SECURITY_REVIEW
  LEGAL_REVIEW
  APPROVED
  REJECTED
}

enum CertificationStatus {
  NOT_STARTED
  IN_PROGRESS
  PASSED
  FAILED
  EXPIRED
}

enum HealthScoreTier {
  HEALTHY
  AT_RISK
  CRITICAL
  CHURNED
}

// ── Auth / Multi-tenant (§10) ───────────────────────────────────

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  passwordHash     String
  locale           String            @default("pt-BR")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  memberships      Membership[]
  sellerProfile    SellerProfile?
  sellerSkills     SellerSkill[]
  roleplaySessions RoleplaySession[]
  trainingPlans    TrainingPlan[]
  activities       Activity[]
  auditLogs        AuditLog[]
  certifications   Certification[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships            Membership[]
  companies              Company[]
  contacts               Contact[]
  deals                  Deal[]
  calls                  Call[]
  objections             Objection[]
  followUps              FollowUp[]
  tasks                  Task[]
  roiModels              ROIModel[]
  aiInsights             AIInsight[]
  aiUsages               AIUsage[]
  aiJobs                 AIJob[]
  roleplayScenarios      RoleplayScenario[]
  roleplaySessions       RoleplaySession[]
  coachingSessions       CoachingSession[]
  trainingPlans          TrainingPlan[]
  activities             Activity[]
  auditLogs              AuditLog[]
  webhookEndpoints       WebhookEndpoint[]
  automationRules        AutomationRule[]
  integrationConnections IntegrationConnection[]
  aiConfig               AIConfig?
  forecastSnapshots      ForecastSnapshot[]
  stakeholders           Stakeholder[]
  mapItems               MAPItem[]
  procurementChecklists  ProcurementChecklist[]
  callClips              CallClip[]
  scorecardTemplates     ScorecardTemplate[]
  certifications         Certification[]
  accountHealth          AccountHealth[]
  expansionPlaybooks     ExpansionPlaybook[]

  @@index([slug])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// ── CRM Core (§24-27) ───────────────────────────────────────────

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  website        String?
  industry       String?
  companySize    String? // e.g. "1-10" "11-50" "51-200" "201-1000" "1000+"
  revenueRange   String?
  location       String?
  cnpj           String?
  description    String?  @db.Text
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts           Contact[]
  deals              Deal[]
  accountHealth      AccountHealth?
  expansionPlaybooks ExpansionPlaybook[]

  @@index([organizationId])
  @@index([name])
  @@index([cnpj])
}

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  companyId      String
  name           String
  role           String?
  email          String?
  phone          String?
  linkedinUrl    String?
  decisionRole   DecisionRole @default(UNKNOWN)
  consentAt      DateTime?
  consentSource  String?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deals        Deal[]        @relation("PrimaryContact")
  Stakeholder  Stakeholder[]

  @@index([organizationId])
  @@index([companyId])
  @@index([email])
}

model Deal {
  id                String            @id @default(cuid())
  organizationId    String
  companyId         String
  primaryContactId  String?
  name              String
  stage             DealStage         @default(LEAD)
  forecastCategory  ForecastCategory? // PIPELINE | COMMIT | BEST_CASE | UPSIDE
  value             Decimal?          @db.Decimal(14, 2)
  currency          String            @default("BRL")
  probability       Int? // 0-100
  expectedCloseDate DateTime?
  source            String?
  currentSolution   String?           @db.Text
  desiredOutcome    String?           @db.Text
  painSummary       String?           @db.Text
  urgency           String?
  decisionProcess   String?           @db.Text
  decisionCriteria  String?           @db.Text
  nextStep          String?           @db.Text
  nextStepDate      DateTime?
  lostReason        String?           @db.Text
  ownerId           String?
  commitDate        DateTime?
  commitNote        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  primaryContact       Contact?              @relation("PrimaryContact", fields: [primaryContactId], references: [id])
  calls                Call[]
  discoveryFields      DiscoveryField[]
  objections           Objection[]
  followUps            FollowUp[]
  tasks                Task[]
  roiModels            ROIModel[]
  aiInsights           AIInsight[]
  Stakeholder          Stakeholder[]
  MAPItem              MAPItem[]
  ProcurementChecklist ProcurementChecklist?

  @@index([organizationId])
  @@index([companyId])
  @@index([stage])
  @@index([expectedCloseDate])
  @@index([createdAt])
  @@index([ownerId])
}

// ── Discovery (§29-30) ───────────────────────────────────────────

model DiscoveryField {
  id         String               @id @default(cuid())
  dealId     String
  key        String // situation | problem | impact | cause | consequence | cost | urgency | desiredOutcome | decisionMaker | decisionProcess | decisionCriteria | budget | nextStep
  status     DiscoveryFieldStatus @default(UNKNOWN)
  value      String?              @db.Text
  confidence Float? // 0-1
  source     DiscoveryFieldSource @default(CRM)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, key])
  @@index([dealId])
}

// ── Calls & Transcripts (§32-35) ─────────────────────────────────

model Call {
  id             String         @id @default(cuid())
  organizationId String
  dealId         String?
  contactId      String?
  title          String
  scheduledAt    DateTime?
  duration       Int? // seconds
  status         CallStatus     @default(SCHEDULED)
  analysisStatus AnalysisStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id])
  transcript   Transcript?
  aiInsights   AIInsight[]
  objections   Objection[]
  clips        CallClip[]

  @@index([organizationId])
  @@index([dealId])
  @@index([contactId])
  @@index([createdAt])
  @@index([analysisStatus])
}

model Transcript {
  id              String   @id @default(cuid())
  callId          String   @unique
  content         String   @db.Text
  language        String   @default("pt-BR")
  speakerSegments Json? // [{speaker, text, start, end}]
  createdAt       DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
}

// ── Objections / FollowUp / Tasks / ROI ──────────────────────────

model Objection {
  id             String            @id @default(cuid())
  organizationId String
  dealId         String?
  callId         String?
  category       ObjectionCategory
  content        String            @db.Text
  handled        Boolean           @default(false)
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id])
  call         Call?        @relation(fields: [callId], references: [id])

  @@index([organizationId])
  @@index([dealId])
}

model FollowUp {
  id             String         @id @default(cuid())
  organizationId String
  dealId         String
  callId         String?
  type           FollowUpType
  subject        String?
  content        String         @db.Text
  status         FollowUpStatus @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([dealId])
}

model Task {
  id             String     @id @default(cuid())
  organizationId String
  dealId         String?
  assigneeId     String?
  title          String
  description    String?    @db.Text
  dueDate        DateTime?
  status         TaskStatus @default(TODO)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id])

  @@index([organizationId])
  @@index([dealId])
  @@index([status])
}

model ROIModel {
  id             String      @id @default(cuid())
  organizationId String
  dealId         String
  scenario       ROIScenario @default(BASE)
  inputs         Json
  outputs        Json // { monthlySavings, annualSavings, revenueUpside, totalAnnualImpact, roi, paybackPeriod }
  assumptions    Json?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([dealId])
}

// ── AI / Coaching ────────────────────────────────────────────────

model AIInsight {
  id                String   @id @default(cuid())
  organizationId    String
  dealId            String?
  callId            String?
  type              String // missed_opportunity | discovery_gap | objection | coaching | risk | etc.
  title             String
  evidence          String?  @db.Text
  confidence        Float? // 0-1
  whyItMatters      String?  @db.Text
  recommendedAction String?  @db.Text
  metadata          Json?
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id])
  call         Call?        @relation(fields: [callId], references: [id])

  @@index([organizationId])
  @@index([dealId])
  @@index([type])
}

model AIRecommendation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  type           String // roleplay | training | coaching
  title          String
  reason         String?  @db.Text
  payload        Json?
  dismissed      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
}

model CoachingSession {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  periodStart    DateTime?
  periodEnd      DateTime?
  summary        String?   @db.Text
  strengths      Json?
  weaknesses     Json?
  trends         Json?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

// ── Roleplay Engine (§47-64) ─────────────────────────────────────

model RoleplayScenario {
  id                String             @id @default(cuid())
  organizationId    String? // null = global template
  title             String
  industry          String?
  companySize       String?
  ticket            String?
  persona           String // CEO | CFO | CTO | etc.
  difficulty        RoleplayDifficulty @default(LEVEL_1)
  publicContext     String             @db.Text
  hiddenContext     Json // §50 hidden: realProblem, monthlyImpact, budget, decisionMaker, etc.
  painPoints        Json?
  businessImpact    String?            @db.Text
  urgency           String?
  decisionMaker     String?
  decisionProcess   String?            @db.Text
  decisionCriteria  String?            @db.Text
  budget            String?
  currentSolution   String?
  competitors       Json?
  objections        Json? // string[]
  successCriteria   Json?
  failureCriteria   Json?
  trainingObjective String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization Organization?     @relation(fields: [organizationId], references: [id])
  sessions     RoleplaySession[]

  @@index([organizationId])
  @@index([difficulty])
}

model RoleplaySession {
  id             String                @id @default(cuid())
  organizationId String
  userId         String
  scenarioId     String
  startedAt      DateTime              @default(now())
  completedAt    DateTime?
  status         RoleplaySessionStatus @default(ACTIVE)
  objective      String?
  overallScore   Int?
  transcript     Json? // cached transcript copy
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario     RoleplayScenario    @relation(fields: [scenarioId], references: [id])
  messages     RoleplayMessage[]
  evaluation   RoleplayEvaluation?

  @@index([organizationId])
  @@index([userId])
  @@index([scenarioId])
  @@index([status])
}

model RoleplayMessage {
  id        String   @id @default(cuid())
  sessionId String
  speaker   Speaker
  content   String   @db.Text
  timestamp DateTime @default(now())
  metadata  Json?

  session RoleplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model RoleplayEvaluation {
  id                   String   @id @default(cuid())
  sessionId            String   @unique
  overallScore         Int
  skills               Json // { discovery, listening, impactQuantification, objectionHandling, closing, ... }
  strengths            Json? // string[]
  weaknesses           Json?
  decisiveMoments      Json? // [{ timestamp, prospectStatement, whatWasMissed, recommendedQuestion, severity }]
  errorTypes           Json? // string[]
  recommendedExercises Json?
  createdAt            DateTime @default(now())

  session RoleplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model RoleplayScore {
  id        String   @id @default(cuid())
  userId    String
  sessionId String?
  skill     String // discovery | listening | questioning | etc. (§70)
  score     Int // 0-100
  source    String   @default("roleplay") // roleplay | real_call
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([skill])
  @@index([source])
}

// ── Training / Seller Profile (§69-71) ───────────────────────────

model TrainingPlan {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  week           Int?
  focus          String?
  exercises      Json? // TrainingExercise[] inline or relation
  goal           String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingExercises TrainingExercise[]

  @@index([organizationId])
  @@index([userId])
}

model TrainingExercise {
  id         String     @id @default(cuid())
  planId     String
  title      String
  type       String // discovery_drill | objection_drill | etc.
  scenarioId String?
  status     TaskStatus @default(TODO)
  dueDate    DateTime?
  createdAt  DateTime   @default(now())

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model SellerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  organizationId     String
  sellingStyle       String?
  targetMarket       String?
  targetTicket       String?
  preferredMethod    String?
  strengths          Json?
  weaknesses         Json?
  personalRisks      Json?
  coachingPriorities Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model SellerSkill {
  id           String   @id @default(cuid())
  userId       String
  skill        String // discovery | listening | questioning | qualification | painDiagnosis ...
  currentScore Int // 0-100
  targetScore  Int?
  trend        String? // up | down | stable
  confidence   Float? // 0-1
  sampleSize   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
  @@index([userId])
}

// ── Ops / Observability (§91-92) ─────────────────────────────────

model Activity {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  entityType     String
  entityId       String
  action         String // created | updated | deleted | analyzed | etc.
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String // user.login | deal.created | call.analyzed | etc. (§91)
  entityType     String?
  entityId       String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([action])
  @@index([createdAt])
}

model AIUsage {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  provider       String // openai | anthropic | gemini | openrouter
  model          String
  operation      String // generateText | generateStructured | embed | classify | etc.
  agent          String? // ResearchAgent | CallAnalyst | RoleplayAgent | etc.
  inputTokens    Int?
  outputTokens   Int?
  estimatedCost  Float?
  latencyMs      Int?
  status         String   @default("success") // success | error | timeout
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([provider])
  @@index([createdAt])
}

model AIJob {
  id             String    @id @default(cuid())
  organizationId String?
  type           String // analyze_transcript | generate_followup | evaluate_roleplay | etc.
  status         JobStatus @default(PENDING)
  payload        Json
  result         Json?
  error          String?   @db.Text
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  runAt          DateTime? // for delayed / scheduled jobs
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([status])
  @@index([runAt])
  @@index([type])
}

// ── Webhooks §83 ─────────────────────────────────────────────────

model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  secret         String
  events         Json // string[] — e.g. ["deal.created","call.completed"]
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  endpointId     String
  organizationId String
  event          String
  payload        Json
  idempotencyKey String?  @unique
  status         String   @default("pending") // pending | success | failed | retrying
  attempts       Int      @default(0)
  lastError      String?  @db.Text
  responseStatus Int?
  responseBody   String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([endpointId])
  @@index([event])
}

// ── Automation Engine §84 ────────────────────────────────────────

model AutomationRule {
  id             String   @id @default(cuid())
  organizationId String
  trigger        String // e.g. call.completed | deal.created | roleplay.completed
  enabled        Boolean  @default(true)
  conditions     Json? // optional [{field,op,value}] — evaluated shallow in MVP
  actions        Json // [{type, params}] — see src/lib/automation.ts for allowed types
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([organizationId])
  @@index([trigger])
}

model AutomationRun {
  id             String   @id @default(cuid())
  ruleId         String
  organizationId String
  triggerEvent   String
  triggerPayload Json?
  status         String   @default("pending") // pending | success | failed
  result         Json?
  error          String?  @db.Text
  createdAt      DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([organizationId])
}

// ── Integrations §85 (Phase 11) ───────────────────────────────
model IntegrationConnection {
  id             String   @id @default(cuid())
  organizationId String
  provider       String
  kind           String // calendar | transcript | crm
  status         String   @default("connected")
  config         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([provider])
}

model AIConfig {
  id             String   @id @default(cuid())
  organizationId String   @unique
  provider       String   @default("openai")
  model          String?
  openaiKey      String?
  anthropicKey   String?
  geminiKey      String?
  openrouterKey  String?
  litellmUrl     String?  @default("http://litellm:4000")
  litellmKey     String?
  useLitellm     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ── Forecast / Waterfall (Phase 1) ─────────────────────────────────
model ForecastSnapshot {
  id             String           @id @default(cuid())
  organizationId String
  userId         String? // null = org level
  period         String // YYYY-MM
  category       ForecastCategory
  amount         Decimal          @db.Decimal(14, 2)
  dealsCount     Int
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, period, category])
  @@index([organizationId])
  @@index([period])
}

// ── Stakeholder Map + MAP Buyer Portal (Phase 2) ───────────────────
model Stakeholder {
  id              String               @id @default(cuid())
  organizationId  String
  dealId          String
  contactId       String?
  name            String
  title           String?
  email           String?
  phone           String?
  role            StakeholderRole
  influence       StakeholderInfluence @default(MEDIUM)
  sentiment       StakeholderSentiment @default(UNKNOWN)
  isChampion      Boolean              @default(false)
  isDecisionMaker Boolean              @default(false)
  notes           String?              @db.Text
  lastEngagement  DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([dealId])
}

// ── MAP Items ──────────────────────────────────────────────────────
model MAPItem {
  id             String        @id @default(cuid())
  organizationId String
  dealId         String
  title          String
  description    String?       @db.Text
  owner          String? // buyer-side owner name
  ownerEmail     String?
  dueDate        DateTime?
  status         MAPItemStatus @default(NOT_STARTED)
  order          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([dealId])
}

// ── Procurement Checklist ──────────────────────────────────────────
model ProcurementChecklist {
  id                    String            @id @default(cuid())
  organizationId        String
  dealId                String            @unique
  questionnaireSent     Boolean           @default(false)
  questionnaireReceived Boolean           @default(false)
  securityReview        Boolean           @default(false)
  legalReview           Boolean           @default(false)
  status                ProcurementStatus @default(NOT_STARTED)
  notes                 String?           @db.Text
  submittedAt           DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([dealId])
}

// ── Semantic Call Library + Clips + Certifications (Phase 3) ───────
model CallClip {
  id             String   @id @default(cuid())
  organizationId String
  callId         String
  userId         String // creator
  title          String
  startTime      Int // seconds from call start
  endTime        Int // seconds from call start
  transcript     String   @db.Text
  tags           String[] // objection category, skill, etc.
  isPublic       Boolean  @default(false) // shared with team
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  call         Call         @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([callId])
  @@index([userId])
  @@index([tags])
}

model ScorecardTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?  @db.Text
  criteria       Json // [{ skill, weight, description, minScore }]
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Certification Certification[]

  @@index([organizationId])
}

model Certification {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  name           String
  description    String?             @db.Text
  templateId     String?
  status         CertificationStatus @default(NOT_STARTED)
  score          Int?
  passedAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     ScorecardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
}

// ── Customer Success / Health Score (Phase 4) ──────────────────────
model AccountHealth {
  id                 String          @id @default(cuid())
  organizationId     String
  companyId          String          @unique
  overallScore       Int // 0-100
  tier               HealthScoreTier @default(HEALTHY)
  adoptionScore      Int? // 0-100
  engagementScore    Int? // 0-100
  supportScore       Int? // 0-100
  npsScore           Int? // -100 to 100
  lastLoginDays      Int?
  lastTouchDays      Int?
  openTickets        Int?
  churnRisk          Float? // 0-1
  expansionPotential Float? // 0-1
  signals            Json? // [{ type, value, date, source }]
  calculatedAt       DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([organizationId])
}

model ExpansionPlaybook {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  trigger        String // e.g. "high_adoption_low_usage", "contract_renewal_90d"
  conditions     Json // [{ field, op, value }]
  steps          Json // [{ action, templateId, delayDays, ownerRole }]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id])
  companyId    String?

  @@index([organizationId])
  @@index([trigger])
}
