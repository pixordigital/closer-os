# Production environment — copy to .env.prod and fill
# Never commit .env.prod

# ── Database ──
# DB_PASSWORD used by entrypoint to build DATABASE_URL + by db (POSTGRES_PASSWORD). Keep in sync.
DB_PASSWORD=<strong-random-password>
POSTGRES_PASSWORD=<same-as-DB_PASSWORD>
# DATABASE_URL=postgresql://closer:<DB_PASSWORD>@db:5432/closer_os?schema=public  # alternative: set directly

# ── Auth ──
AUTH_SECRET=<openssl rand -base64 32>
APP_URL=http://178.105.181.38:6002

# ── AI Providers ──
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Storage (S3 / MinIO / R2) ──
STORAGE_ENDPOINT=
STORAGE_BUCKET=closer-os
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# ── Redis (optional) ──
REDIS_URL=

# ── Observability ──
LOG_LEVEL=info

# ── Integrations (Phase 11) ──
GOOGLE_CALENDAR_CREDENTIALS=