# Closer OS — Environment Variables
# Copy to .env and fill values. Never commit .env.

# ── Database ──
# Local (docker-compose): 5433 — host already has PG on 5432
DATABASE_URL="postgresql://closer:closer@localhost:5433/closer_os?schema=public"
# In Docker network (app → db):
# DATABASE_URL="postgresql://closer:closer@db:5432/closer_os?schema=public"

# ── Auth ──
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-32-random-chars-min"
APP_URL="http://localhost:3000"

# ── AI Providers (set at least one) ──
AI_PROVIDER="openai" # openai | anthropic | gemini | openrouter
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# ── Storage (S3 / MinIO / R2) — optional in Phase 1 ──
STORAGE_ENDPOINT=""
STORAGE_BUCKET="closer-os"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="us-east-1"

# ── Redis (optional — only if job queue needs it) ──
REDIS_URL=""

# ── Integrations (Phase 11) ──
# Google Calendar OAuth token (optional stub; mock providers work without it)
GOOGLE_CALENDAR_CREDENTIALS=""

# ── WhatsApp Evolution (Baileys) ──
# Local docker-compose: http://evolution:8080 (inside network) / http://localhost:8080 (host)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="closer-evolution-key-change-me"
# Public webhook URL Evolution will POST inbound to (must be reachable from Evolution)
# Local dev: use ngrok or set to http://localhost:3000/api/whatsapp/webhook (only inside docker)
# Prod (Coolify): http://178.105.181.38:6002/api/whatsapp/webhook
EVOLUTION_WEBHOOK_URL="http://localhost:3000/api/whatsapp/webhook"
# Cron secret for /api/jobs/run worker (curl every 10s) — generate: openssl rand -hex 16
CRON_SECRET=""

# ── Observability ──
LOG_LEVEL="info"
