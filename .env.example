# Closer OS — Environment Variables
# Copy to .env and fill values. Never commit .env.

# ── Database ──
# Local (docker-compose): 5433 — host already has PG on 5432
DATABASE_URL="postgresql://closer:closer@localhost:5433/closer_os?schema=public"
# In Docker network (app → db):
# DATABASE_URL="postgresql://closer:closer@db:5432/closer_os?schema=public"

# ── Auth ──
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-32-random-chars-min"
APP_URL="http://localhost:3000"

# ── AI Providers (set at least one) ──
AI_PROVIDER="openai" # openai | anthropic | gemini | openrouter
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# ── Storage (S3 / MinIO / R2) — optional in Phase 1 ──
STORAGE_ENDPOINT=""
STORAGE_BUCKET="closer-os"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="us-east-1"

# ── Redis (optional — only if job queue needs it) ──
REDIS_URL=""

# ── Observability ──
LOG_LEVEL="info"
